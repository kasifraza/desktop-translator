{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translate Bubble",
  "version": "0.1.0",
  "identifier": "tech.openforge.translatebubble",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bubble",
        "url": "index.html",
        "title": "Translate Bubble",
        "width": 64,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Translate Bubble",
        "width": 420,
        "height": 640,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Hindi / Hinglish to clean English, anywhere",
    "publisher": "Kasif Raza",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
