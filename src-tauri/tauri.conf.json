{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translate Bubble",
  "version": "0.1.0",
  "identifier": "tech.openforge.translatebubble",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bubble",
        "url": "index.html",
        "title": "Translate Bubble",
        "width": 64,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Translate Bubble",
        "width": 420,
        "height": 480,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
